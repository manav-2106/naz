# Upstash Redis Configuration (Create a free database at https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Secret Keys
# NAZ_KEY: Embedded in her private link as /#k=your_naz_key or /?k=your_naz_key
NAZ_KEY=naz_super_secret_birthday_key_2026

# OWNER_KEY: Mr. Naz's owner key for adding monthly reasons and admin controls
OWNER_KEY=mr_naz_owner_secret_key_2026

# Test Override (ONLY for testing locally or in staging: set to "true" to test unlocking the capsule early)
TEST_UNLOCK_OVERRIDE=false
